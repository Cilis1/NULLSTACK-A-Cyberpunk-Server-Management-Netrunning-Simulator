set(sandbox "${CMAKE_CURRENT_BINARY_DIR}/game-cli-test")
file(MAKE_DIRECTORY "${sandbox}")
file(WRITE "${sandbox}/input.txt" "host\nsave\nhost\nload\nquit\n")
execute_process(COMMAND "${GAME}" 42 WORKING_DIRECTORY "${sandbox}" INPUT_FILE "${sandbox}/input.txt" OUTPUT_VARIABLE output RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR NOT output MATCHES "Hosting contracts paid out" OR NOT output MATCHES "DAY 1" OR NOT output MATCHES "OK: ok" OR NOT output MATCHES "Disconnected")
  message(FATAL_ERROR "Interactive game failed: ${result}\n${output}")
endif()
if(NOT EXISTS "${sandbox}/back-room.sqlite")
  message(FATAL_ERROR "CLI failed to create a save")
endif()
file(REMOVE_RECURSE "${sandbox}")
